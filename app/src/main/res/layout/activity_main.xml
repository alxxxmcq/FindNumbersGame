<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F7FA">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="НАЙДИ ЧИСЛА"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1E3D5E"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="4dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ищем:"
            android:textSize="18sp"/>

        <TextView
            android:id="@+id/tvTargetNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="1"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2A7F4A"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ошибки:"
            android:textSize="18sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvMistakes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#B33A3A"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Время:"
            android:textSize="18sp"
            android:gravity="right"/>

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="00:00"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E3D5E"
            android:gravity="right"/>
    </LinearLayout>

    <GridLayout
        android:id="@+id/gridGame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="5"
        android:rowCount="5"
        android:alignmentMode="alignMargins"
        android:padding="8dp"
        android:background="@android:color/white"
        android:elevation="2dp"/>

    <Button
        android:id="@+id/btnNewGame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="НОВАЯ ИГРА"
        android:backgroundTint="#1E3D5E"
        android:textColor="#FFFFFF"
        android:padding="14dp"/>

</LinearLayout>